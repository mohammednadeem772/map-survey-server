# Server port
PORT=4000

# Prisma connection string.
# Format: mysql://<user>:<password>@<host>:<port>/<database>
# Local/dev example:
DATABASE_URL="mysql://map_user:MapPassword123!@localhost:3306/map_survey"

# cPanel MySQL example (replace host/db/user — cPanel usually prefixes the DB
# name and user with your cPanel account name, e.g. cpaneluser_map_survey):
# DATABASE_URL="mysql://cpaneluser_dbuser:password@your-domain-or-ip:3306/cpaneluser_map_survey"

# Signing secret for JWTs — use a long random value outside local development.
JWT_SECRET=replace-with-a-long-random-secret

# Comma-separated list of origins allowed to call this API.
CLIENT_ORIGIN=http://localhost:5173

# When true, resets the three demo accounts' passwords to the documented
# defaults on every server start. Set to false after first deploy.
SEED_DEMO_USERS=false
